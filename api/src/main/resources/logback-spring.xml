<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <!-- Custom pattern to mask sensitive data -->
    <conversionRule conversionWord="mask" class="com.dmerc12.api.logging.SensitiveDataMaskConverter" />
    <!-- JSON appender for console (or file) -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.JsonEncoder">
            <jsonGeneratorDecorator class="ch.qos.logback.contrib.jackson.JacksonJsonGeneratorDecorator" />
            <timestampFormat>yyyy-MM-dd'T'HH:mm:ss.SSSZ</timestampFormat>
            <appendLineSeparator>true</appendLineSeparator>
        </encoder>
    </appender>
    <!-- Standard text console for development -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
        <logger name="com.dmerc12" level="DEBUG" />
    </springProfile>
    <!-- Production: JSON Logging (structured) -->
    <springProfile name="!dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON" />
        </root>
        <logger name="com.dmerc12" level="INFO" />
    </springProfile>
    <!-- Audit Logger (separate log file if needed) -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/app/logs/audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>/app/logs/audit-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{ISO8601} %m%n</pattern>
        </encoder>
    </appender>
    <logger name="AUDIT_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE" />
    </logger>
</configuration>
